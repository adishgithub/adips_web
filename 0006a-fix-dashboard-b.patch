             const SizedBox(height: AdipsSizes.md),
           ],
           BalanceCard(
diff --git a/test/dashboard_controller_test.dart b/test/dashboard_controller_test.dart
index e39201a..40d0e31 100644
--- a/test/dashboard_controller_test.dart
+++ b/test/dashboard_controller_test.dart
@@ -1,6 +1,10 @@
+import 'dart:io';
+
 import 'package:adips_web/utils/http/http_client.dart';
 import 'package:adips_web/web/dashboard/dashboard_controller.dart';
+import 'package:flutter/services.dart';
 import 'package:flutter_test/flutter_test.dart';
+import 'package:get_storage/get_storage.dart';
 import 'package:http/http.dart' as http;
 import 'package:http/testing.dart';
 
@@ -29,6 +33,20 @@ String _stats(num credit, num debit, int count) =>
     '"balance":${credit - debit},"transaction_count":$count}}';
 
 void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  // The services read the saved token from GetStorage, which needs a folder:
+  // point path_provider at a temp dir so it can start in a test.
+  setUpAll(() async {
+    final dir = Directory.systemTemp.createTempSync('adips_test_');
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(
+      const MethodChannel('plugins.flutter.io/path_provider'),
+      (call) async => dir.path,
+    );
+    await GetStorage.init();
+  });
+
   late http.Client original;
   late List<Uri> requests;
   late bool failStats;
