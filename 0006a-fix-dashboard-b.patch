diff --git a/lib/web/dashboard/dashboard_controller.dart b/lib/web/dashboard/dashboard_controller.dart
index 59e0c76..e321b4d 100644
--- a/lib/web/dashboard/dashboard_controller.dart
+++ b/lib/web/dashboard/dashboard_controller.dart
@@ -104,12 +104,12 @@ class DashboardController extends GetxController {
     } finally {
       if (seq == _seq) isLoading.value = false;
     }
-    if (dropped) await refresh();
+    if (dropped) await reload();
   }
 
   /// Quiet reload (no spinner): after changes made elsewhere. A failure keeps
   /// the old numbers and sets [refreshError] for an inline banner.
-  Future<void> refresh() async {
+  Future<void> reload() async {
     final seq = ++_seq;
     var dropped = false;
     isRefreshing.value = true;
@@ -133,7 +133,7 @@ class DashboardController extends GetxController {
     } finally {
       if (seq == _seq) isRefreshing.value = false;
     }
-    if (dropped) await refresh();
+    if (dropped) await reload();
   }
 
   /// Tap an account to filter the stat cards to it; tap it again (or pass
