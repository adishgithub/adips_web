+import 'package:flutter/material.dart';
+
+import '../../utils/constants/adips_palette.dart';
+import '../../utils/constants/sizes.dart';
+import '../../utils/helpers/helper_functions.dart';
+import '../common/adaptive_grid.dart';
+
+/// Income / expenses / transaction count (from /transactions/summary).
+class StatCards extends StatelessWidget {
+  const StatCards({
+    super.key,
+    required this.totalIncome,
+    required this.totalExpenses,
+    required this.totalTransactions,
+    this.currency = 'INR',
+  });
+
+  final double totalIncome;
+  final double totalExpenses;
+  final int totalTransactions;
+  final String currency;
+
+  @override
+  Widget build(BuildContext context) {
+    final isDark = AdipsHelperFunctions.isDarkMode(context);
+    final gain = isDark ? AdipsPalette.darkGain : AdipsPalette.lightGain;
+    final loss = isDark ? AdipsPalette.darkLoss : AdipsPalette.lightLoss;
+    final action = isDark ? AdipsPalette.darkAction : AdipsPalette.lightAction;
+    final text = isDark ? AdipsPalette.darkTextPrimary : AdipsPalette.lightTextPrimary;
+
+    return AdaptiveGrid(
+      minItemWidth: 220,
+      maxColumns: 3,
+      children: [
+        _StatCard(
+          icon: Icons.trending_up_rounded,
+          color: gain,
+          label: 'Total Income',
+          value: AdipsFormatters.money(totalIncome, currency),
+          valueColor: gain,
+        ),
+        _StatCard(
+          icon: Icons.trending_down_rounded,
+          color: loss,
+          label: 'Total Expenses',
+          value: AdipsFormatters.money(totalExpenses, currency),
+          valueColor: loss,
+        ),
+        _StatCard(
+          icon: Icons.description_outlined,
+          color: action,
+          label: 'Total Transactions',
+          value: '$totalTransactions',
+          valueColor: text,
+        ),
+      ],
+    );
+  }
+}
+
+class _StatCard extends StatelessWidget {
+  const _StatCard({
+    required this.icon,
+    required this.color,
+    required this.label,
+    required this.value,
+    required this.valueColor,
+  });
+
+  final IconData icon;
+  final Color color;
+  final String label;
+  final String value;
+  final Color valueColor;
+
+  @override
+  Widget build(BuildContext context) {
+    final isDark = AdipsHelperFunctions.isDarkMode(context);
+    final surface = isDark ? AdipsPalette.darkTextField : AdipsPalette.lightTextField;
+    final line = isDark ? AdipsPalette.darkLine : AdipsPalette.lightLine;
+    final muted = isDark ? AdipsPalette.darkTextMuted : AdipsPalette.lightTextMuted;
+
+    return Container(
+      padding: const EdgeInsets.all(AdipsSizes.md),
+      decoration: BoxDecoration(
+        color: surface,
+        borderRadius: BorderRadius.circular(AdipsSizes.borderRadiusSm),
+        border: Border.all(color: line),
+      ),
+      child: Row(
+        children: [
+          Container(
+            padding: const EdgeInsets.all(10),
+            decoration: BoxDecoration(
+              color: color.withValues(alpha: 0.12),
+              shape: BoxShape.circle,
+            ),
+            child: Icon(icon, size: 22, color: color),
+          ),
+          const SizedBox(width: AdipsSizes.md),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(label,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: TextStyle(fontSize: 12, color: muted)),
+                const SizedBox(height: 4),
+                FittedBox(
+                  fit: BoxFit.scaleDown,
+                  alignment: Alignment.centerLeft,
+                  child: Text(value,
+                      maxLines: 1,
+                      style: TextStyle(
+                          fontSize: 20,
+                          fontWeight: FontWeight.w700,
+                          color: valueColor)),
+                ),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/web/dashboard/web_dashboard_page.dart b/lib/web/dashboard/web_dashboard_page.dart
new file mode 100644
index 0000000..dcf77d8
--- /dev/null
+++ b/lib/web/dashboard/web_dashboard_page.dart
@@ -0,0 +1,188 @@
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+
+import '../../utils/constants/sizes.dart';
+import '../layout/web_shell.dart';
+import 'account_card_grid.dart';
+import 'balance_card.dart';
+import 'dashboard_controller.dart';
+import 'stat_cards.dart';
+
+/// /dashboard. Patch 05: total balance, income/expense/count cards and the
+/// account grid. (Filters, search and recent transactions come in Patch 06.)
+class WebDashboardPage extends StatelessWidget {
+  const WebDashboardPage({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final c = Get.find<DashboardController>();
+    return WebShell(
+      title: 'Dashboard',
+      route: '/dashboard',
+      child: Obx(() {
+        if (c.loadError.value != null) {
+          return DashboardErrorView(
+              message: c.loadError.value!, onRetry: c.loadAll);
+        }
+        if (c.isLoading.value && !c.hasLoaded) {
+          return const DashboardLoadingView();
+        }
+        return RefreshIndicator(
+          onRefresh: c.refresh,
+          child: SingleChildScrollView(
+            physics: const AlwaysScrollableScrollPhysics(),
+            padding: const EdgeInsets.all(AdipsSizes.lg),
+            child: DashboardBody(controller: c),
+          ),
+        );
+      }),
+    );
+  }
+}
+
+class DashboardLoadingView extends StatelessWidget {
+  const DashboardLoadingView({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return Center(
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          const CircularProgressIndicator(),
+          const SizedBox(height: AdipsSizes.md),
+          Text(
+            'Loading your accounts… the server may take up to 30 seconds to wake up.',
+            textAlign: TextAlign.center,
+            style: Theme.of(context).textTheme.bodyMedium,
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+class DashboardErrorView extends StatelessWidget {
+  const DashboardErrorView(
+      {super.key, required this.message, required this.onRetry});
+
+  final String message;
+  final VoidCallback onRetry;
+
+  @override
+  Widget build(BuildContext context) {
+    return Center(
+      child: Padding(
+        padding: const EdgeInsets.all(AdipsSizes.lg),
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(maxWidth: 420),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              const Icon(Icons.cloud_off_outlined, size: 48),
+              const SizedBox(height: AdipsSizes.md),
+              Text('Could not load your dashboard',
+                  style: Theme.of(context).textTheme.titleMedium),
+              const SizedBox(height: AdipsSizes.sm),
+              Text(message, textAlign: TextAlign.center),
+              const SizedBox(height: AdipsSizes.lg),
+              ElevatedButton(onPressed: onRetry, child: const Text('Try again')),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// The dashboard content. Public so Patch 06 can extend it and tests can
+/// pump it with a controller.
+class DashboardBody extends StatelessWidget {
+  const DashboardBody({super.key, required this.controller});
+
+  final DashboardController controller;
+
+  @override
+  Widget build(BuildContext context) {
+    final c = controller;
+    return Obx(() {
+      final selected = c.selectedAccount;
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          if (c.isRefreshing.value) ...[
+            const LinearProgressIndicator(minHeight: 2),
+            const SizedBox(height: AdipsSizes.sm),
+          ],
+          if (c.refreshError.value != null) ...[
+            _ErrorBanner(message: c.refreshError.value!, onRetry: c.refresh),
+            const SizedBox(height: AdipsSizes.md),
+          ],
+          BalanceCard(
+            totals: c.accountSummary.value.totals,
+            fallbackCurrency: c.statsCurrency,
+          ),
+          const SizedBox(height: AdipsSizes.lg),
+          if (selected != null)
+            Padding(
+              padding: const EdgeInsets.only(bottom: AdipsSizes.sm),
+              child: Wrap(
+                crossAxisAlignment: WrapCrossAlignment.center,
+                spacing: AdipsSizes.sm,
+                children: [
+                  Text('Showing figures for ${selected.name}'),
+                  TextButton(
+                    onPressed: () => c.selectAccount(null),
+                    child: const Text('Show all'),
+                  ),
+                ],
+              ),
+            ),
+          StatCards(
+            totalIncome: c.stats.value.totalCredit,
+            totalExpenses: c.stats.value.totalDebit,
+            totalTransactions: c.stats.value.count,
+            currency: c.statsCurrency,
+          ),
+          const SizedBox(height: AdipsSizes.lg),
+          Text('Accounts', style: Theme.of(context).textTheme.titleMedium),
+          const SizedBox(height: AdipsSizes.sm),
+          AccountCardGrid(
+            accounts: c.accounts.toList(),
+            selectedId: c.selectedAccountId.value,
+            onTap: (a) => c.selectAccount(a.id),
+            onAddAccount: () => Get.toNamed('/accounts'),
+          ),
+        ],
+      );
+    });
+  }
+}
+
+class _ErrorBanner extends StatelessWidget {
+  const _ErrorBanner({required this.message, required this.onRetry});
+
+  final String message;
+  final VoidCallback onRetry;
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    return Container(
+      padding: const EdgeInsets.all(AdipsSizes.sm),
+      decoration: BoxDecoration(
+        color: scheme.errorContainer,
+        borderRadius: BorderRadius.circular(AdipsSizes.borderRadiusSm),
+      ),
+      child: Wrap(
+        crossAxisAlignment: WrapCrossAlignment.center,
+        spacing: AdipsSizes.sm,
+        children: [
+          Icon(Icons.error_outline, color: scheme.onErrorContainer, size: 18),
+          Text(message, style: TextStyle(color: scheme.onErrorContainer)),
+          TextButton(onPressed: onRetry, child: const Text('Retry')),
+        ],
+      ),
+    );
+  }
+}
diff --git a/test/dashboard_controller_test.dart b/test/dashboard_controller_test.dart
new file mode 100644
index 0000000..80c43ae
--- /dev/null
+++ b/test/dashboard_controller_test.dart
@@ -0,0 +1,104 @@
+import 'package:adips_web/utils/http/http_client.dart';
+import 'package:adips_web/web/dashboard/dashboard_controller.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+
+const _accounts = '''
+{"success":true,"data":[
+ {"id":1,"name":"Main","type":"bank","currency":"INR","opening_balance":0,
+  "current_balance":1500,"icon_id":1,"color_id":1,"sort_order":1,
+  "is_default":true,"include_in_total":true,"is_archived":false},
+ {"id":2,"name":"Cash","type":"cash","currency":"USD","opening_balance":0,
+  "current_balance":20,"icon_id":2,"color_id":2,"sort_order":2,
+  "is_default":false,"include_in_total":true,"is_archived":false}]}''';
+
+const _accountSummary = '''
+{"success":true,"data":{"totals":[{"currency":"INR","total_balance":1500},
+ {"currency":"USD","total_balance":20}],"accounts":[]}}''';
+
+String _stats(num credit, num debit, int count) =>
+    '{"success":true,"data":{"total_credit":$credit,"total_debit":$debit,'
+    '"balance":${credit - debit},"transaction_count":$count}}';
+
+void main() {
+  late http.Client original;
+  late List<Uri> requests;
+  late bool failStats;
+
+  setUp(() {
+    original = AdipsHttpHelper.client;
+    requests = [];
+    failStats = false;
+    AdipsHttpHelper.client = MockClient((req) async {
+      requests.add(req.url);
+      final path = req.url.path;
+      if (path.endsWith('/accounts/summary')) {
+        return http.Response(_accountSummary, 200);
+      }
+      if (path.endsWith('/accounts')) return http.Response(_accounts, 200);
+      if (path.endsWith('/transactions/summary')) {
+        if (failStats) return http.Response('{"message":"boom"}', 500);
+        return req.url.queryParameters['account_id'] == '2'
+            ? http.Response(_stats(5, 1, 2), 200)
+            : http.Response(_stats(100, 40, 9), 200);
+      }
+      return http.Response('{}', 404);
+    });
+  });
+
+  tearDown(() => AdipsHttpHelper.client = original);
+
+  test('loadAll fills accounts, totals and stats', () async {
+    final c = DashboardController();
+    await c.loadAll();
+
+    expect(c.loadError.value, isNull);
+    expect(c.isLoading.value, isFalse);
+    expect(c.accounts.length, 2);
+    expect(c.accountSummary.value.totals.first.totalBalance, 1500);
+    expect(c.stats.value.totalCredit, 100);
+    expect(c.stats.value.count, 9);
+    expect(c.statsCurrency, 'INR'); // first total
+  });
+
+  test('selecting an account re-fetches stats for it; again clears it',
+      () async {
+    final c = DashboardController();
+    await c.loadAll();
+
+    await c.selectAccount(2);
+    expect(c.selectedAccountId.value, 2);
+    expect(c.stats.value.count, 2);
+    expect(c.statsCurrency, 'USD'); // the selected account's
+    expect(requests.last.queryParameters['account_id'], '2');
+
+    await c.selectAccount(2); // same card again = back to all
+    expect(c.selectedAccountId.value, isNull);
+    expect(c.stats.value.count, 9);
+  });
+
+  test('a failed filter keeps the previous selection and reports an error',
+      () async {
+    final c = DashboardController();
+    await c.loadAll();
+
+    failStats = true;
+    await c.selectAccount(2);
+
+    expect(c.selectedAccountId.value, isNull);
+    expect(c.stats.value.count, 9);
+    expect(c.refreshError.value, isNotNull);
+    expect(c.isRefreshing.value, isFalse);
+  });
+
+  test('a failed first load sets loadError and clears the spinner', () async {
+    failStats = true;
+    final c = DashboardController();
+    await c.loadAll();
+
+    expect(c.loadError.value, isNotNull);
+    expect(c.isLoading.value, isFalse);
+    expect(c.hasLoaded, isFalse);
+  });
+}
