+/// Width classes from the ADIPS Web plan (section 7).
+///
+/// * [ScreenSize.expanded] >= 1200px: full sidebar + multi-column content
+/// * [ScreenSize.medium]   768-1199px: icon rail + reduced grid columns
+/// * [ScreenSize.compact]  < 768px: drawer navigation + stacked content
+enum ScreenSize { compact, medium, expanded }
+
+class Breakpoints {
+  Breakpoints._();
+
+  static const double medium = 768;
+  static const double expanded = 1200;
+
+  /// Page content is centred and never wider than this.
+  static const double contentMaxWidth = 1400;
+
+  static ScreenSize fromWidth(double width) {
+    if (width >= expanded) return ScreenSize.expanded;
+    if (width >= medium) return ScreenSize.medium;
+    return ScreenSize.compact;
+  }
+
+  /// Outer padding of the page content area for a given width class.
+  static double contentPadding(ScreenSize size) {
+    switch (size) {
+      case ScreenSize.compact:
+        return 16;
+      case ScreenSize.medium:
+        return 24;
+      case ScreenSize.expanded:
+        return 32;
+    }
+  }
+}
