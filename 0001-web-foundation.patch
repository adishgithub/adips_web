+import 'package:adips_web/core/responsive/breakpoints.dart';
+import 'package:adips_web/routes/app_routes.dart';
+import 'package:adips_web/web/layout/nav_items.dart';
+import 'package:adips_web/web/layout/responsive_layout.dart';
+import 'package:adips_web/web/layout/web_header.dart';
+import 'package:adips_web/web/layout/web_sidebar.dart';
+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+
+/// Authenticated app frame: sidebar + header + centred content area.
+///
+/// ≥1200px full sidebar, 768-1199px icon rail, <768px drawer.
+class WebShell extends StatefulWidget {
+  const WebShell({super.key, required this.location, required this.child});
+
+  /// Current route path (drives the selected nav item and header title).
+  final String location;
+  final Widget child;
+
+  @override
+  State<WebShell> createState() => _WebShellState();
+}
+
+class _WebShellState extends State<WebShell> {
+  final GlobalKey<ScaffoldState> _scaffoldKey = GlobalKey<ScaffoldState>();
+
+  void _go(String path) {
+    _scaffoldKey.currentState?.closeDrawer();
+    if (path != widget.location) context.go(path);
+  }
+
+  // TEMPORARY (Patch 01): Patch 02 replaces this with the real logout
+  // (clear token/session, then redirect to /login).
+  void _logout() => context.go(AppRoutes.login);
+
+  @override
+  Widget build(BuildContext context) {
+    return ResponsiveLayout(
+      builder: (context, size, constraints) {
+        final compact = size == ScreenSize.compact;
+        final railOnly = size == ScreenSize.medium;
+
+        return Scaffold(
+          key: _scaffoldKey,
+          drawer: compact
+              ? Drawer(
+                  child: SafeArea(
+                    child: WebSidebar(location: widget.location, onNavigate: _go),
+                  ),
+                )
+              : null,
+          body: Row(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              if (!compact)
+                WebSidebar(
+                  location: widget.location,
+                  onNavigate: _go,
+                  collapsed: railOnly,
+                  width: railOnly
+                      ? WebSidebar.collapsedWidth
+                      : WebSidebar.expandedWidth,
+                ),
+              Expanded(
+                child: Column(
+                  children: [
+                    WebHeader(
+                      title: AdipsNav.titleFor(widget.location),
+                      compact: compact,
+                      onMenuPressed: () => _scaffoldKey.currentState?.openDrawer(),
+                      onNavigate: _go,
+                      onLogout: _logout,
+                    ),
+                    Expanded(
+                      child: Align(
+                        alignment: Alignment.topCenter,
+                        child: ConstrainedBox(
+                          constraints: const BoxConstraints(
+                            maxWidth: Breakpoints.contentMaxWidth,
+                          ),
+                          child: Padding(
+                            padding: EdgeInsets.all(Breakpoints.contentPadding(size)),
+                            child: widget.child,
+                          ),
+                        ),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        );
+      },
+    );
+  }
+}
diff --git a/lib/web/layout/web_sidebar.dart b/lib/web/layout/web_sidebar.dart
new file mode 100644
index 0000000..5c90b38
--- /dev/null
+++ b/lib/web/layout/web_sidebar.dart
@@ -0,0 +1,209 @@
+import 'package:adips_web/core/constants/adips_palette.dart';
+import 'package:adips_web/core/constants/sizes.dart';
+import 'package:adips_web/core/constants/web_assets.dart';
+import 'package:adips_web/core/theme/custom_theme/adips_colors.dart';
+import 'package:adips_web/web/layout/nav_items.dart';
+import 'package:flutter/material.dart';
+
+/// Persistent left navigation.
+///
+/// * [collapsed] = false: logo + icon/label rows (>= 1200px, and inside the
+///   drawer on narrow screens)
+/// * [collapsed] = true: icon rail with tooltips (768-1199px)
+///
+/// Purely presentational: it receives the current [location] and reports taps
+/// through [onNavigate], so it is easy to widget-test and has no router
+/// dependency.
+class WebSidebar extends StatelessWidget {
+  const WebSidebar({
+    super.key,
+    required this.location,
+    required this.onNavigate,
+    this.collapsed = false,
+    this.width,
+  });
+
+  static const double expandedWidth = 248;
+  static const double collapsedWidth = 76;
+
+  final String location;
+  final ValueChanged<String> onNavigate;
+  final bool collapsed;
+
+  /// Null = fill the available width (used inside a Drawer).
+  final double? width;
+
+  @override
+  Widget build(BuildContext context) {
+    final c = Theme.of(context).extension<AdipsColors>()!;
+    final isDark = Theme.of(context).brightness == Brightness.dark;
+    final accent =
+        isDark ? AdipsPalette.darkPrimaryBrandText : AdipsPalette.lightPrimaryBrandText;
+
+    return Container(
+      width: width,
+      decoration: BoxDecoration(
+        color: c.surface,
+        border: Border(right: BorderSide(color: c.divider)),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          _Brand(collapsed: collapsed, isDark: isDark),
+          Divider(height: 1, color: c.divider),
+          Expanded(
+            child: ListView(
+              padding: EdgeInsets.symmetric(
+                horizontal: collapsed ? AdipsSizes.sm : AdipsSizes.md,
+                vertical: AdipsSizes.md,
+              ),
+              children: [
+                for (final item in AdipsNav.items)
+                  Padding(
+                    padding: const EdgeInsets.only(bottom: AdipsSizes.xs),
+                    child: _NavTile(
+                      item: item,
+                      selected: item.matches(location),
+                      collapsed: collapsed,
+                      accent: accent,
+                      onTap: () => onNavigate(item.path),
+                    ),
+                  ),
+              ],
+            ),
+          ),
+          if (!collapsed)
+            Padding(
+              padding: const EdgeInsets.all(AdipsSizes.md),
+              child: Text(
+                'ADIPS Web v1.0.0',
+                style: TextStyle(color: c.textHint, fontSize: AdipsSizes.fontSizesEs),
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
+
+class _Brand extends StatelessWidget {
+  const _Brand({required this.collapsed, required this.isDark});
+
+  final bool collapsed;
+  final bool isDark;
+
+  @override
+  Widget build(BuildContext context) {
+    final fallback = Text(
+      'ADIPS',
+      style: TextStyle(
+        fontWeight: FontWeight.w700,
+        color: Theme.of(context).extension<AdipsColors>()!.textPrimary,
+      ),
+    );
+
+    Widget logo;
+    if (collapsed) {
+      logo = Image.asset(
+        isDark ? WebAssets.symbolOnDark : WebAssets.symbolOnLight,
+        height: 36,
+        width: 36,
+        errorBuilder: (context, error, stackTrace) => fallback,
+      );
+    } else {
+      // The horizontal artwork has generous transparent padding; crop it to a
+      // fixed-height strip so it reads at sidebar size.
+      logo = SizedBox(
+        height: 56,
+        child: ClipRect(
+          child: OverflowBox(
+            maxHeight: 130,
+            maxWidth: 260,
+            child: Image.asset(
+              isDark
+                  ? WebAssets.horizontalLogoOnDark
+                  : WebAssets.horizontalLogoOnLight,
+              height: 130,
+              width: 260,
+              fit: BoxFit.contain,
+              errorBuilder: (context, error, stackTrace) => fallback,
+            ),
+          ),
+        ),
+      );
+    }
+
+    return SizedBox(
+      height: 72,
+      child: Center(child: logo),
+    );
+  }
+}
+
+class _NavTile extends StatelessWidget {
+  const _NavTile({
+    required this.item,
+    required this.selected,
+    required this.collapsed,
+    required this.accent,
+    required this.onTap,
+  });
+
+  final NavItem item;
+  final bool selected;
+  final bool collapsed;
+  final Color accent;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final c = Theme.of(context).extension<AdipsColors>()!;
+    final color = selected ? accent : c.textMuted;
+    final radius = BorderRadius.circular(AdipsSizes.borderRadiusMd);
+
+    final tile = Semantics(
+      button: true,
+      selected: selected,
+      label: item.label,
+      child: Material(
+        color: Colors.transparent,
+        child: InkWell(
+          borderRadius: radius,
+          onTap: onTap,
+          child: Container(
+            height: 44,
+            padding: const EdgeInsets.symmetric(horizontal: 12),
+            decoration: BoxDecoration(
+              color: selected ? accent.withValues(alpha: 0.14) : null,
+              borderRadius: radius,
+            ),
+            child: Row(
+              mainAxisAlignment:
+                  collapsed ? MainAxisAlignment.center : MainAxisAlignment.start,
+              children: [
+                Icon(selected ? item.selectedIcon : item.icon, color: color, size: 22),
+                if (!collapsed) ...[
+                  const SizedBox(width: 12),
+                  Expanded(
+                    child: Text(
+                      item.label,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(
+                        color: color,
+                        fontSize: AdipsSizes.fontSizesSm,
+                        fontWeight: selected ? FontWeight.w600 : FontWeight.w500,
+                      ),
+                    ),
+                  ),
+                ],
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+
+    return collapsed ? Tooltip(message: item.label, child: tile) : tile;
+  }
+}
