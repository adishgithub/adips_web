@@ -0,0 +1,96 @@
+import 'package:adips_web/routes/app_routes.dart';
+import 'package:flutter/material.dart';
+
+class NavItem {
+  const NavItem({
+    required this.label,
+    required this.icon,
+    required this.selectedIcon,
+    required this.path,
+    this.matchPrefixes = const [],
+  });
+
+  final String label;
+  final IconData icon;
+  final IconData selectedIcon;
+  final String path;
+
+  /// Extra route prefixes that should highlight this item
+  /// (e.g. /transfers/add belongs to Transactions).
+  final List<String> matchPrefixes;
+
+  bool matches(String location) {
+    for (final p in [path, ...matchPrefixes]) {
+      if (location == p || location.startsWith('$p/')) return true;
+    }
+    return false;
+  }
+}
+
+class AdipsNav {
+  AdipsNav._();
+
+  static const List<NavItem> items = [
+    NavItem(
+      label: 'Dashboard',
+      icon: Icons.dashboard_outlined,
+      selectedIcon: Icons.dashboard,
+      path: AppRoutes.dashboard,
+    ),
+    NavItem(
+      label: 'Transactions',
+      icon: Icons.receipt_long_outlined,
+      selectedIcon: Icons.receipt_long,
+      path: AppRoutes.transactions,
+      matchPrefixes: ['/transfers'],
+    ),
+    NavItem(
+      label: 'Accounts',
+      icon: Icons.account_balance_wallet_outlined,
+      selectedIcon: Icons.account_balance_wallet,
+      path: AppRoutes.accounts,
+    ),
+    NavItem(
+      label: 'Categories',
+      icon: Icons.category_outlined,
+      selectedIcon: Icons.category,
+      path: AppRoutes.categories,
+    ),
+    NavItem(
+      label: 'Transaction Types',
+      icon: Icons.swap_horiz,
+      selectedIcon: Icons.swap_horiz,
+      path: AppRoutes.transactionTypes,
+    ),
+    NavItem(
+      label: 'Settings',
+      icon: Icons.settings_outlined,
+      selectedIcon: Icons.settings,
+      path: AppRoutes.settings,
+      matchPrefixes: [AppRoutes.profile],
+    ),
+  ];
+
+  static NavItem? forLocation(String location) {
+    for (final item in items) {
+      if (item.matches(location)) return item;
+    }
+    return null;
+  }
+
+  /// Header title for a location.
+  static String titleFor(String location) {
+    switch (location) {
+      case AppRoutes.transactionAdd:
+        return 'Add Transaction';
+      case AppRoutes.transferAdd:
+        return 'New Transfer';
+      case AppRoutes.profile:
+        return 'Profile';
+    }
+    if (location.startsWith('${AppRoutes.transactions}/')) {
+      return 'Transaction Details';
+    }
+    return forLocation(location)?.label ?? 'ADIPS';
+  }
+}
