new file mode 100644
index 0000000..ebdb4eb
--- /dev/null
+++ b/lib/core/theme/theme_controller.dart
@@ -0,0 +1,32 @@
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+import 'package:get_storage/get_storage.dart';
+
+/// Light/dark switch for the web app. Persisted in browser storage.
+///
+/// Dark is the default because the plan keeps the dark theme as the primary
+/// ADIPS identity (the mobile app follows the system setting; revisit if
+/// product wants parity).
+class ThemeController extends GetxController {
+  static ThemeController get to => Get.find<ThemeController>();
+
+  static const String _storageKey = 'web_theme_mode';
+
+  final GetStorage _box = GetStorage();
+  final Rx<ThemeMode> mode = ThemeMode.dark.obs;
+
+  bool get isDark => mode.value == ThemeMode.dark;
+
+  @override
+  void onInit() {
+    super.onInit();
+    mode.value = _box.read<String>(_storageKey) == 'light'
+        ? ThemeMode.light
+        : ThemeMode.dark;
+  }
+
+  void toggle() {
+    mode.value = isDark ? ThemeMode.light : ThemeMode.dark;
+    _box.write(_storageKey, isDark ? 'dark' : 'light');
+  }
+}
