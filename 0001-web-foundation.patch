diff --git a/tools/sync_shared.sh b/tools/sync_shared.sh
new file mode 100755
index 0000000..2315a89
--- /dev/null
+++ b/tools/sync_shared.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Copies platform-independent shared code from the mobile app (adips_app)
+# into this web project and rewrites imports so nothing is retyped by hand.
+#
+# Usage:  tools/sync_shared.sh /path/to/adips_app <group> [<group> ...]
+# Groups are added patch by patch (see docs/DEVELOPMENT_PATCHES.md).
+#   theme      lib/utils/theme + palette/sizes/images/text constants   (Patch 01)
+set -euo pipefail
+APP="${1:?path to adips_app required}"; shift
+WEB="$(cd "$(dirname "$0")/.." && pwd)"
+
+rewrite() {
+  # $1 = directory to rewrite. Keep this mapping in sync with the doc.
+  grep -rl "package:adips/" "$1" 2>/dev/null | xargs -r sed -i \
+    -e 's#package:adips/utils/theme/#package:adips_web/core/theme/#g' \
+    -e 's#package:adips/utils/constants/#package:adips_web/core/constants/#g'
+}
+
+for group in "$@"; do
+  case "$group" in
+    theme)
+      mkdir -p "$WEB/lib/core/constants" "$WEB/lib/core/theme"
+      for f in adips_palette sizes image_strings text_strings; do
+        cp "$APP/lib/utils/constants/$f.dart" "$WEB/lib/core/constants/"
+      done
+      cp "$APP/lib/utils/theme/adips_app_theme.dart" "$WEB/lib/core/theme/"
+      cp -r "$APP/lib/utils/theme/custom_theme" "$WEB/lib/core/theme/"
+      rewrite "$WEB/lib/core"
+      ;;
+    *) echo "unknown group: $group" >&2; exit 1 ;;
+  esac
+done
+echo "sync done: $*"
