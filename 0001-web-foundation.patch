+import 'package:adips_web/routes/app_routes.dart';
+import 'package:adips_web/web/auth/auth_placeholder_page.dart';
+import 'package:adips_web/web/common/not_found_page.dart';
+import 'package:adips_web/web/common/page_placeholder.dart';
+import 'package:adips_web/web/layout/web_shell.dart';
+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+
+class AppRouter {
+  AppRouter._();
+
+  static final GoRouter router = GoRouter(
+    initialLocation: AppRoutes.dashboard,
+    errorBuilder: (context, state) => NotFoundPage(location: state.uri.toString()),
+    routes: [
+      GoRoute(path: '/', redirect: (context, state) => AppRoutes.dashboard),
+
+      // Outside the shell. Patch 02 replaces these and adds the auth guard.
+      GoRoute(
+        path: AppRoutes.login,
+        builder: (context, state) =>
+            const AuthPlaceholderPage(title: 'Sign in', patch: 2),
+      ),
+      GoRoute(
+        path: AppRoutes.register,
+        builder: (context, state) =>
+            const AuthPlaceholderPage(title: 'Create account', patch: 2),
+      ),
+      GoRoute(
+        path: AppRoutes.onboarding,
+        builder: (context, state) =>
+            const AuthPlaceholderPage(title: 'Welcome to ADIPS', patch: 2),
+      ),
+
+      // Inside the shell. Order matters: /transactions/add before /:id.
+      ShellRoute(
+        builder: (context, state, child) =>
+            WebShell(location: state.uri.path, child: child),
+        routes: [
+          _page(AppRoutes.dashboard, 'Dashboard', Icons.dashboard_outlined, 3),
+          _page(AppRoutes.transactions, 'Transactions', Icons.receipt_long_outlined, 4),
+          _page(AppRoutes.transactionAdd, 'Add Transaction', Icons.add_card_outlined, 4),
+          _page(
+            AppRoutes.transactionDetails,
+            'Transaction Details',
+            Icons.receipt_long_outlined,
+            4,
+            detailsFor: (s) => 'Transaction #${s.pathParameters['id']}',
+          ),
+          _page(AppRoutes.transferAdd, 'New Transfer', Icons.swap_horiz, 5),
+          _page(AppRoutes.accounts, 'Accounts', Icons.account_balance_wallet_outlined, 6),
+          _page(AppRoutes.categories, 'Categories', Icons.category_outlined, 7),
+          _page(AppRoutes.transactionTypes, 'Transaction Types', Icons.swap_horiz, 7),
+          _page(AppRoutes.settings, 'Settings', Icons.settings_outlined, 8),
+          _page(AppRoutes.profile, 'Profile', Icons.person_outline, 8),
+        ],
+      ),
+    ],
+  );
+
+  static GoRoute _page(
+    String path,
+    String title,
+    IconData icon,
+    int patch, {
+    String Function(GoRouterState state)? detailsFor,
+  }) {
+    return GoRoute(
+      path: path,
+      pageBuilder: (context, state) => NoTransitionPage<void>(
+        key: state.pageKey,
+        child: PagePlaceholder(
+          title: title,
+          icon: icon,
+          patch: patch,
+          details: detailsFor?.call(state),
+        ),
+      ),
+    );
+  }
+}
